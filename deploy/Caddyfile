# /etc/caddy/Caddyfile —— pii 项目「拥有」的文件，deploy/deploy.sh 会整份覆盖它
#
# 结构（方案 B）：
#   1. 全局块：只放跨站点的设置
#   2. piihub.icu / www.piihub.icu：pii 自己的站点
#   3. import /etc/caddy/sites/*.caddy：其他项目各自维护的站点文件
#
# 为什么这样拆：pii 部署时会把本文件整份装到 /etc/caddy/Caddyfile。
# 过去别的站点（shanshui/odo/grafana/tesla）也写在同一份文件里，于是每次 pii 部署
# 都被一并抹掉（2026-11-09、2026-11-16 各一次）。现在它们挪到 sites/ 下，
# pii 的部署只能覆盖自己这一段，物理上不可能再误删别人。

{
	# 80 端口被 teslamate-grafana 占用，Caddy 不能去 bind :80。
	# disable_redirects = 不启动 http->https 跳转服务（443 的 TLS 与证书申请照常工作）。
	auto_https disable_redirects
}

piihub.icu, www.piihub.icu {
	encode zstd gzip

	# 80 不可用 -> 强制用 TLS-ALPN-01 验证（复用 443，不需要 80）
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	reverse_proxy 127.0.0.1:8443 {
		# SSE 流式必须关缓冲，否则 agent 吐字会被憋成一坨
		flush_interval -1
	}
}

# 其他站点：一个站点一个文件，由各自项目维护，pii 部署不会碰它们。
# 目录为空时 Caddy 只告警不报错，新机器照样能起来。
import /etc/caddy/sites/*.caddy
