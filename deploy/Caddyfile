# /etc/caddy/Caddyfile —— 线上（阿里云 47.102.100.84）真实使用的版本
#
# 作用：https://piihub.icu (443，Let's Encrypt 真证书) → 本地 pii 容器 8443 (明文 http)
# 为什么需要这一层：pii 自己只在 8443 跑 http，而 PWA / Web Push 要求 HTTPS 安全上下文。

{
	# 80 端口被 teslamate-grafana 占用，Caddy 不能去 bind :80。
	# disable_redirects = 不启动 http->https 跳转服务（443 的 TLS 与证书申请照常工作）。
	auto_https disable_redirects
}

piihub.icu, www.piihub.icu {
	encode zstd gzip

	# 80 不可用 -> 强制用 TLS-ALPN-01 验证（复用 443，不需要 80）
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	reverse_proxy 127.0.0.1:8443 {
		# SSE 流式必须关缓冲，否则 agent 吐字会被憋成一坨
		flush_interval -1
	}
}
